@{
    ViewData["Title"] = "Yönetim Paneli";
}
@model MythosBalance.ViewModels.AdminDashboardViewModel

<div class="admin-layout position-relative z-1">

    <!-- ===== SIDEBAR ===== -->
    <aside class="admin-sidebar">
        <div style="font-family:var(--font-display); font-size:0.9rem; color:var(--color-gold); padding:0.5rem 0.5rem 1rem;">
            <i class="bi bi-shield-check me-2"></i>Yönetim
        </div>

        <div class="admin-sidebar-title">Menü</div>
        <a class="admin-nav-link" href="/Admin">
            <i class="bi bi-speedometer2"></i> Pano
        </a>
        <a class="admin-nav-link" href="/Admin/Users">
            <i class="bi bi-people"></i> Kullanıcılar
        </a>
        <a class="admin-nav-link" href="/Admin/Guides">
            <i class="bi bi-book-half"></i> Olimpos
        </a>

        <div class="admin-sidebar-title" style="margin-top:1.5rem;">Diğer</div>
        <a class="admin-nav-link" asp-controller="Home" asp-action="Index">
            <i class="bi bi-house"></i> Panoya Dön
        </a>
    </aside>

    <!-- ===== İÇERİK ===== -->
    <div class="admin-content">

        <div class="mb-4">
            <h1 style="font-family:var(--font-display); font-size:1.6rem; color:var(--color-gold);">
                Yönetim Paneli
            </h1>
            <p style="color:var(--color-muted); font-size:0.88rem;">Platform genel durumuna genel bakış.</p>
        </div>

        <!-- İstatistik Kartları -->
        <div class="row g-3 mb-5">
            <div class="col-sm-4">
                <div class="stat-card" style="border-color:rgba(97,175,239,0.3);">
                    <div class="stat-number" style="color:#61afef;">@Model.TotalUsers</div>
                    <div class="stat-label">Toplam Kullanıcı</div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="stat-card" style="border-color:rgba(86,182,194,0.3);">
                    <div class="stat-number" style="color:#56b6c2;">@Model.TotalActivities</div>
                    <div class="stat-label">Toplam Aktivite</div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="stat-card" style="border-color:rgba(198,120,221,0.3);">
                    <div class="stat-number" style="color:#c678dd;">@Model.TotalGuides</div>
                    <div class="stat-label">Mitoloji Rehberi</div>
                </div>
            </div>
        </div>

        <!-- Son Kayıtlar -->
        <div class="glass-card p-0 overflow-hidden">
            <div class="px-4 pt-4 pb-3 d-flex align-items-center justify-content-between">
                <h2 style="font-family:var(--font-display); font-size:1rem; color:var(--color-gold); margin:0;">
                    <i class="bi bi-people me-2"></i>Son Kayıt Olan Kullanıcılar
                </h2>
                <a href="/Admin/Users" class="btn-ghost" style="font-size:0.78rem; padding:0.35rem 0.8rem;">
                    Tümünü Gör →
                </a>
            </div>

            @foreach (var user in Model.RecentUsers)
            {
                <div style="display:flex; align-items:center; gap:1rem; padding:0.85rem 1.25rem;
                            border-bottom:1px solid rgba(255,255,255,0.04);">
                    <div style="width:36px; height:36px; border-radius:50%;
                                background:var(--color-gold-dim); border:1px solid var(--color-border);
                                display:flex; align-items:center; justify-content:center;
                                font-family:var(--font-display); color:var(--color-gold); font-size:0.9rem; flex-shrink:0;">
                        @(user.DisplayName.Length > 0 ? user.DisplayName[0].ToString().ToUpper() : "?")
                    </div>
                    <div style="flex:1; min-width:0;">
                        <div style="font-size:0.88rem; font-weight:500;">@user.DisplayName</div>
                        <div style="font-size:0.78rem; color:var(--color-muted);">@user.Email</div>
                    </div>
                    <span style="font-size:0.75rem; padding:0.2rem 0.6rem; border-radius:99px;
                                 @(user.Role == "Admin" ? "background:rgba(201,168,76,0.15); color:var(--color-gold); border:1px solid rgba(201,168,76,0.3);" : "background:rgba(97,175,239,0.1); color:#61afef; border:1px solid rgba(97,175,239,0.25);")"
                        >@user.Role</span>
                    <div style="font-size:0.78rem; color:var(--color-muted);">@user.ActivityCount aktivite</div>
                </div>
            }
        </div>

    </div>
</div>

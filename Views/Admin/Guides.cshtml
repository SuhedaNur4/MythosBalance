@{
    ViewData["Title"] = "Olimpos Rehberleri Yönetimi";
}
@model List<MythosBalance.Models.MythologyGuide>

<div class="admin-layout position-relative z-1">

    <!-- SIDEBAR -->
    <aside class="admin-sidebar">
        <div style="font-family:var(--font-display); font-size:0.9rem; color:var(--color-gold); padding:0.5rem 0.5rem 1rem;">
            <i class="bi bi-shield-check me-2"></i>Yönetim
        </div>
        <div class="admin-sidebar-title">Menü</div>
        <a class="admin-nav-link" href="/Admin"><i class="bi bi-speedometer2"></i> Pano</a>
        <a class="admin-nav-link" href="/Admin/Users"><i class="bi bi-people"></i> Kullanıcılar</a>
        <a class="admin-nav-link" href="/Admin/Guides"><i class="bi bi-book-half"></i> Olimpos</a>
        <div class="admin-sidebar-title" style="margin-top:1.5rem;">Diğer</div>
        <a class="admin-nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i> Panoya Dön</a>
    </aside>

    <!-- İÇERİK -->
    <div class="admin-content">
        <div class="mb-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <h1 style="font-family:var(--font-display); font-size:1.5rem; color:var(--color-gold);">
                    <i class="bi bi-book-half me-2"></i>Olimpos Rehberleri
                </h1>
                <p style="color:var(--color-muted); font-size:0.88rem;">Toplam @Model.Count rehber.</p>
            </div>
        </div>

        <div class="glass-card p-0 overflow-hidden">
            <div style="display:grid; grid-template-columns:auto 1fr 1fr auto auto;
                        gap:1rem; padding:0.7rem 1.25rem;
                        border-bottom:1px solid var(--color-border);
                        font-size:0.72rem; text-transform:uppercase; letter-spacing:0.08em; color:var(--color-muted);">
                <span>#</span>
                <span>Rehber</span>
                <span>Yaşam Alanı</span>
                <span>Kaynak</span>
                <span>İşlem</span>
            </div>

            @foreach (var guide in Model)
            {
                <div style="display:grid; grid-template-columns:auto 1fr 1fr auto auto;
                            gap:1rem; align-items:center; padding:0.85rem 1.25rem;
                            border-bottom:1px solid rgba(255,255,255,0.03);
                            transition:var(--transition);"
                     onmouseover="this.style.background='rgba(255,255,255,0.02)'"
                     onmouseout="this.style.background='transparent'">

                    <div style="font-size:0.85rem; color:var(--color-muted);">@guide.Id</div>

                    <div>
                        <div style="font-size:0.9rem; font-weight:600; color:var(--color-gold);">@guide.Name</div>
                        <div style="font-size:0.78rem; color:var(--color-muted);">@guide.Title</div>
                    </div>

                    <div>
                        <span class="badge-domain badge-@guide.LifeDomain.Name.ToLower()">
                            <i class="@guide.LifeDomain.IconClass" style="font-size:0.7rem;"></i>
                            @guide.LifeDomain.TurkishName
                        </span>
                    </div>

                    <div style="font-size:0.83rem; color:var(--color-muted);">
                        @guide.References.Count kaynak
                    </div>

                    <div>
                        <a asp-controller="Guide" asp-action="Detail" asp-route-id="@guide.Id"
                           class="btn-ghost" style="font-size:0.78rem; padding:0.35rem 0.7rem;">
                            <i class="bi bi-eye"></i>
                        </a>
                    </div>
                </div>
            }
        </div>

        <div class="alert-mythos mt-4" style="font-size:0.82rem;">
            <i class="bi bi-info-circle me-2"></i>
            Mitoloji rehberlerinin içerikleri SeedData aracılığıyla yüklenmektedir. İçerik düzenleme için doğrudan veritabanı yönetimi veya gelecek sürümde admin form sayfaları eklenebilir.
        </div>
    </div>
</div>

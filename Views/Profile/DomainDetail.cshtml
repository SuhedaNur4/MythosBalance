@model MythosBalance.ViewModels.DomainDetailViewModel
@{
    ViewData["Title"] = Model.Domain.TurkishName + " Detayı";
}

<div class="container py-4 position-relative z-1">

    <div class="mb-4">
        <a asp-action="Index" class="btn-ghost d-inline-flex align-items-center">
            <i class="bi bi-arrow-left me-1"></i>Profile Dön
        </a>
    </div>

    <!-- ===== ALAN KİMLİĞİ ===== -->
    <div class="glass-card p-0 overflow-hidden mb-4 d-flex flex-wrap align-items-center">
        <!-- Sol: Görsel -->
        <div style="flex:0 0 200px; max-width:200px; height:100%; border-right:1px solid var(--color-border-soft);">
            @if (Model.Domain.MythologyGuide != null && !string.IsNullOrEmpty(Model.Domain.MythologyGuide.ImagePath))
            {
                <img src="@Model.Domain.MythologyGuide.ImagePath" alt="@Model.Domain.TurkishName" style="width:100%; height:100%; object-fit:cover; aspect-ratio:4/5;" />
            }
            else
            {
                <div style="width:100%; height:100%; aspect-ratio:4/5; background:var(--color-bg-alt); display:flex; align-items:center; justify-content:center;">
                    <i class="@Model.Domain.IconClass" style="font-size:3rem; color:var(--color-muted);"></i>
                </div>
            }
        </div>

        <!-- Sağ: Bilgiler -->
        <div style="flex:1; padding:2rem 2.5rem; min-width:300px;">
            <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.5rem;">
                <div style="width:16px; height:16px; border-radius:4px; background:@Model.Domain.ColorHex;"></div>
                <h1 style="font-family:var(--font-display); font-size:2rem; color:var(--color-gold); margin:0;">
                    @Model.Domain.TurkishName
                </h1>
            </div>
            
            <p style="font-size:1rem; color:var(--color-muted); margin-bottom:1.5rem;">
                @Model.Domain.Description
            </p>

            <div style="font-style:italic; font-size:1.05rem; color:var(--color-text-soft); padding-left:1.5rem; border-left:3px solid var(--color-gold-light);">
                @Model.Quote
            </div>
        </div>
    </div>

    <!-- ===== AY AY AKTİVİTELER ===== -->
    @if (!Model.ActivitiesByMonth.Any())
    {
        <div class="glass-card p-5 text-center">
            <i class="bi bi-journal-x" style="font-size:3rem; color:var(--color-muted); opacity:0.4; display:block; margin-bottom:1rem;"></i>
            <h3 style="font-size:1rem; color:var(--color-muted);">Bu alanda henüz aktivite kaydınız yok</h3>
            <a asp-controller="Activity" asp-action="Create" class="btn-gold mt-3">
                <i class="bi bi-plus-lg me-1"></i>Aktivite Ekle
            </a>
        </div>
    }
    else
    {
        foreach (var monthGroup in Model.ActivitiesByMonth)
        {
            <div class="mb-5">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <h3 style="font-family:var(--font-display); font-size:1.25rem; color:var(--color-text); margin:0;">
                        @monthGroup.Key
                    </h3>
                    <div style="flex:1; height:1px; background:var(--color-border-soft);"></div>
                    <span style="font-size:0.8rem; color:var(--color-muted); font-weight:600;">@monthGroup.Value.Count Aktivite</span>
                </div>

                <div class="glass-card-flat p-0 overflow-hidden">
                    @foreach (var activity in monthGroup.Value)
                    {
                        <div style="display:flex; align-items:center; padding:1rem 1.5rem; border-bottom:1px solid rgba(60,40,10,0.06); transition:var(--transition);"
                             onmouseover="this.style.background='rgba(154,110,46,0.04)'"
                             onmouseout="this.style.background='transparent'">
                             
                            <div style="flex:1;">
                                <div style="font-weight:500; font-size:0.95rem; color:var(--color-text-soft); margin-bottom:0.15rem;">
                                    @activity.Title
                                </div>
                                @if (!string.IsNullOrEmpty(activity.Description))
                                {
                                    <div style="font-size:0.8rem; color:var(--color-muted); margin-bottom:0.3rem;">
                                        @activity.Description
                                    </div>
                                }
                                <div style="font-size:0.75rem; color:var(--color-gold);">
                                    <i class="bi bi-calendar-event me-1"></i>@activity.Date.ToString("dd MMMM", new System.Globalization.CultureInfo("tr-TR"))
                                    @if (activity.DurationMinutes.HasValue)
                                    {
                                        <span class="mx-2">|</span>
                                        <i class="bi bi-clock me-1"></i><text>@activity.DurationMinutes dk</text>
                                    }
                                </div>
                            </div>

                            <div style="display:flex; gap:0.4rem; padding-left:1rem;">
                                <a asp-controller="Activity" asp-action="Edit" asp-route-id="@activity.Id" class="btn-ghost" style="padding:0.3rem 0.6rem; font-size:0.75rem;"><i class="bi bi-pencil"></i></a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }

</div>

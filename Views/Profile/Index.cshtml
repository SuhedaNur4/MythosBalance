@{
    ViewData["Title"] = "Profilim";
}
@model MythosBalance.ViewModels.ProfileViewModel

<div class="container py-4 position-relative z-1">

    <!-- ===== PROFİL BAŞLIK ===== -->
    <div class="glass-card p-4 mb-4">
        <div class="d-flex align-items-center gap-4 flex-wrap">

            <!-- Avatar -->
            <div class="profile-avatar">
                @(Model.DisplayName.Length > 0 ? Model.DisplayName[0].ToString().ToUpper() : "?")
            </div>

            <!-- Bilgiler -->
            <div style="flex:1; min-width:200px;">
                <h1 style="font-family:var(--font-display); font-size:1.5rem; color:var(--color-gold); margin:0;">
                    @Model.DisplayName
                </h1>
                <div style="font-size:0.85rem; color:var(--color-muted); margin-top:0.2rem;">
                    <i class="bi bi-envelope me-1"></i>@Model.Email
                </div>
                @if (!string.IsNullOrEmpty(Model.Bio))
                {
                    <p style="font-size:0.9rem; color:var(--color-text); margin-top:0.75rem; max-width:500px; line-height:1.6;">
                        @Model.Bio
                    </p>
                }
                <div style="font-size:0.78rem; color:var(--color-muted); margin-top:0.5rem;">
                    <i class="bi bi-calendar3 me-1"></i>
                    @Model.CreatedAt.ToString("MMMM yyyy", new System.Globalization.CultureInfo("tr-TR")) tarihinden beri üye
                </div>
            </div>

            <!-- Düzenle Butonu -->
            <div>
                <a asp-action="Edit" class="btn-ghost" id="editProfileBtn">
                    <i class="bi bi-pencil me-1"></i>Profili Düzenle
                </a>
            </div>
        </div>
    </div>

    <!-- ===== İSTATİSTİKLER ===== -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-number">@Model.TotalActivities</div>
                <div class="stat-label">Toplam Aktivite</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-number">@Model.ActivitiesThisMonth</div>
                <div class="stat-label">Bu Ay</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-number">@Model.ActivitiesByDomain.Count(x => x.Count > 0)</div>
                <div class="stat-label">Aktif Alan</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card">
                @{
                    var topDomain = Model.ActivitiesByDomain.OrderByDescending(x => x.Count).FirstOrDefault();
                }
                <div class="stat-number" style="font-size:1rem; padding-top:0.4rem;">
                    @(topDomain?.DomainName ?? "—")
                </div>
                <div class="stat-label">En Aktif Alan</div>
            </div>
        </div>
    </div>

    <div class="row g-4">

        <!-- Alan Dağılımı -->
        <div class="col-lg-12">
            <div class="glass-card-flat p-4 h-100">
                <h2 style="font-family:var(--font-display); font-size:1rem; color:var(--color-gold); margin-bottom:1.25rem;">
                    <i class="bi bi-images me-2"></i>Alan Dağılımı
                </h2>

                @if (!Model.ActivitiesByDomain.Any(x => x.Count > 0))
                {
                    <div style="text-align:center; color:var(--color-muted); font-size:0.85rem; padding:2rem 0;">
                        Henüz aktivite kaydı bulunmuyor.
                    </div>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var domain in Model.ActivitiesByDomain.OrderByDescending(x => x.Count))
                        {
                            var pct = Model.TotalActivities > 0 ? domain.Count * 100 / Model.TotalActivities : 0;
                            <div class="col-6 col-md-4 col-lg-3">
                                <a asp-action="DomainDetail" asp-route-id="@domain.DomainId" style="display:block; text-decoration:none; transition:var(--transition);"
                                   onmouseover="this.style.transform='translateY(-4px)'"
                                   onmouseout="this.style.transform='translateY(0)'">
                                    <div style="position:relative; border-radius:10px; overflow:hidden; border:1px solid rgba(154,110,46,0.25); aspect-ratio:4/5; box-shadow:0 4px 12px rgba(60,40,10,0.12);">
                                        @if (!string.IsNullOrEmpty(domain.ImagePath))
                                        {
                                            <img src="@domain.ImagePath" alt="@domain.DomainName" style="width:100%; height:100%; object-fit:cover; filter:brightness(0.85) contrast(1.05);" />
                                        }
                                        <div style="position:absolute; bottom:0; left:0; right:0; padding:12px 10px; background:linear-gradient(to top, rgba(30,20,10,0.9), transparent);">
                                            <div style="font-size:0.9rem; font-weight:600; color:white; text-shadow:0 1px 3px rgba(0,0,0,0.8);">@domain.DomainName</div>
                                            <div style="font-size:0.75rem; color:var(--color-gold-light); font-weight:500;">%@pct <span style="color:rgba(255,255,255,0.6);font-weight:normal;">(@domain.Count)</span></div>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

    </div>
</div>

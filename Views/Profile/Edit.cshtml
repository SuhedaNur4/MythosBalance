@{
    ViewData["Title"] = "Profili Düzenle";
}
@model MythosBalance.ViewModels.ProfileEditViewModel

<div class="container py-4 position-relative z-1">
    <div class="row justify-content-center">
        <div class="col-lg-6">

            <div class="page-header">
                <h1><i class="bi bi-person-gear me-2" style="font-size:1.5rem;"></i>Profili Düzenle</h1>
                <p>Görünen adınızı ve biyografi bilgilerinizi güncelleyebilirsiniz.</p>
            </div>

            <div class="glass-card p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-4">
                        <label class="form-label-mythos" for="editDisplayName">Görünen Ad *</label>
                        <input asp-for="DisplayName" id="editDisplayName" class="form-control-mythos"
                               placeholder="Adınız Soyadınız" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label-mythos" for="editBio">
                            Hakkımda <span style="color:var(--color-muted); font-style:italic;">(isteğe bağlı)</span>
                        </label>
                        <textarea asp-for="Bio" id="editBio" class="form-control-mythos" rows="4"
                                  placeholder="Kendiniz hakkında kısa bir şeyler yazın…"
                                  style="resize:vertical;"></textarea>
                        <div style="font-size:0.75rem; color:var(--color-muted); margin-top:0.35rem;">
                            En fazla 300 karakter
                        </div>
                    </div>

                    <div class="d-flex gap-2 justify-content-end">
                        <a asp-action="Index" class="btn-ghost">
                            <i class="bi bi-arrow-left me-1"></i>Vazgeç
                        </a>
                        <button type="submit" class="btn-gold" id="saveProfileBtn">
                            <i class="bi bi-check-lg me-1"></i>Kaydet
                        </button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

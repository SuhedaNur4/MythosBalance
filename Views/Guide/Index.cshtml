@{
    ViewData["Title"] = "Olimpos Rehberleri";
}
@model List<MythosBalance.Models.MythologyGuide>

<div class="container py-4 position-relative z-1">

    <div class="text-center mb-5">
        <div style="display:inline-block; padding:0.5rem 1rem; background:rgba(201,168,76,0.1); border-radius:20px; color:var(--color-gold); font-size:0.85rem; font-weight:600; margin-bottom:1rem;">
            MYTHOS BALANCE
        </div>
        <h1 style="font-size:2.2rem;">Olimpos'lular ile Yaşam Dengesi</h1>
        <p style="color:var(--color-muted); max-width:600px; margin:0 auto; line-height:1.6;">
            Yaşam alanlarınızda size ilham verecek, antik dünyanın bilgeliğini taşıyan mitolojik figürler.
            Pek çok mitolojik figür olsa da biz burada belirli rehberlere odaklanıyoruz.
        </p>
    </div>

    <!-- Gold ayraç -->
    <div style="text-align:center; margin:1.5rem 0 2.5rem;">
        <span style="display:inline-block; width:60px; height:2px; background:linear-gradient(to right, transparent, var(--color-gold), transparent);"></span>
    </div>

    <!-- REHBER KARTLARI -->
    <div class="row g-4">
        @{
            var domainClasses = new Dictionary<string, string>
            {
                ["Health"]     = "health",
                ["Education"]  = "education",
                ["Creativity"] = "creativity",
                ["Travel"]     = "travel",
                ["Social"]     = "social"
            };

            var guideEmojis = new Dictionary<string, string>
            {
                ["Hygieia"] = "🏺",
                ["Athena"]  = "🦉",
                ["Apollo"]  = "🎵",
                ["Hermes"]  = "🌿",
                ["Charites"]  = "🤝"
            };
        }

        @foreach (var guide in Model)
        {
            var domainClass = domainClasses.TryGetValue(guide.LifeDomain.Name, out var cls) ? cls : "health";
            var emoji = guideEmojis.TryGetValue(guide.Name, out var em) ? em : "⭐";

            <div class="col-sm-6 col-lg-4">
                <div class="guide-card">

                    @if (!string.IsNullOrEmpty(guide.ImagePath))
                    {
                        <div style="width:100%; border-radius:12px 12px 0 0; overflow:hidden;">
                            <img src="@guide.ImagePath" alt="@guide.Name" style="width:100%; height:auto; display:block; filter:brightness(0.85);" />
                        </div>
                    }

                    <!-- Üst Dekor Çizgisi -->
                    <div style="height:3px; background:@guide.LifeDomain.ColorHex; opacity:0.9;"></div>

                    <div class="guide-card-header" style="position:relative; margin-top:-28px;">
                        <!-- Avatar -->
                        <div class="guide-avatar-placeholder mx-auto mb-2" style="border-color:@guide.LifeDomain.ColorHex; background:var(--color-bg); width:56px; height:56px; display:flex; align-items:center; justify-content:center; border-radius:50%; border:2px solid @guide.LifeDomain.ColorHex; z-index:2; position:relative;">
                            <span style="font-size:1.5rem;">@emoji</span>
                        </div>

                        <!-- Yıldız dekor -->
                        <div style="font-family:var(--font-display); font-size:0.65rem;
                                    color:var(--color-muted); letter-spacing:0.15em; margin-bottom:0.5rem;">
                            ✦ &nbsp; @guide.LifeDomain.TurkishName.ToUpper() &nbsp; ✦
                        </div>

                        <div class="guide-name" style="text-transform:none;">@guide.Name.ToUpperInvariant()</div>
                        <div class="guide-title">@guide.Title</div>
                    </div>

                    <div class="guide-card-body">
                        <p class="guide-description">@guide.ShortDescription</p>

                        <!-- Semboller -->
                        <div style="margin:1rem 0 0.75rem;">
                            @foreach (var sym in guide.Symbols.Split(',').Take(3))
                            {
                                <span class="symbol-tag" style="font-size:0.72rem;">@sym.Trim()</span>
                            }
                        </div>

                        <!-- Detay Butonu -->
                        <div style="margin-top:auto; padding-top:0.75rem; border-top:1px solid var(--color-border);">
                            <a asp-controller="Guide" asp-action="Detail" asp-route-id="@guide.Id"
                               class="btn-ghost w-100 text-center" style="display:block; text-decoration:none;">
                                <i class="bi bi-book-open me-2"></i>Detaylı İncele
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Alt not -->
    <div style="text-align:center; margin-top:3rem; color:var(--color-muted); font-size:0.8rem; font-style:italic;">
        Mitolojik bilgiler, saygın akademik kaynaklara dayandırılmıştır. Her rehber kartında kaynaklar listelenmektedir.
    </div>

</div>

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Mythos Balance — Mitoloji ilhamlı yaşam organizasyon platformu. Günlük aktivitelerinizi kaydedin, yaşam dengenizi keşfedin." />
    <title>@ViewData["Title"] — Mythos Balance</title>

    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/images/logo.png" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- ===== NAVBAR ===== -->
    @if (User.Identity?.IsAuthenticated == true)
    {
        <nav class="navbar-mythos">
            <div class="container d-flex align-items-center justify-content-between">

                <a class="navbar-brand-mythos" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png" alt="Logo" style="height:36px; width:36px; object-fit:cover; border-radius:50%; margin-right:8px; border:1px solid rgba(201,168,76,0.3);" />
                    Mythos Balance
                </a>

                <div class="d-flex align-items-center gap-1">
                    <a class="nav-link-mythos" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-grid-1x2"></i> Pano
                    </a>
                    <a class="nav-link-mythos" asp-controller="Activity" asp-action="Index">
                        <i class="bi bi-journal-check"></i> Aktiviteler
                    </a>
                    <a class="nav-link-mythos" asp-controller="Guide" asp-action="Index">
                        <i class="bi bi-book-half"></i> Olimpos
                    </a>
                    <a class="nav-link-mythos" asp-controller="Profile" asp-action="Index">
                        <i class="bi bi-person-circle"></i> Profil
                    </a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a class="nav-link-mythos" asp-controller="Admin" asp-action="Index">
                            <i class="bi bi-shield-check"></i> Yönetim
                        </a>
                    }
                </div>

                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-ghost" style="font-size:0.8rem; padding:0.4rem 0.9rem;">
                        <i class="bi bi-box-arrow-right"></i> Çıkış
                    </button>
                </form>
            </div>
        </nav>
    }

    <!-- ===== MAIN CONTENT ===== -->
    <main class="position-relative z-1">
        @if (TempData["Success"] != null)
        {
            <div class="container mt-3">
                <div id="successAlert" class="alert-success-mythos d-flex align-items-center gap-2" style="border-radius:10px; padding:0.8rem 1rem;">
                    <i class="bi bi-check-circle-fill"></i>
                    @TempData["Success"]
                </div>
            </div>
        }
        @RenderBody()
    </main>

    <!-- ===== FOOTER ===== -->
    @if (User.Identity?.IsAuthenticated == true)
    {
        <footer style="border-top:1px solid var(--color-border); padding:1.5rem 0; margin-top:3rem; position:relative; z-index:1;">
            <div class="container d-flex align-items-center justify-content-between flex-wrap gap-2">
                <span style="font-family:var(--font-display); font-size:0.85rem; color:var(--color-gold);">
                    <img src="~/images/logo.png" alt="Logo" style="height:20px; width:20px; object-fit:cover; border-radius:50%; margin-right:6px;" /> Mythos Balance
                </span>
                <span style="font-size:0.75rem; color:var(--color-muted);">
                    Denge, yansıma ve büyüme üzerine kurulu bir yolculuk.
                </span>
            </div>
        </footer>
    }

    <!-- ===== MODALS ===== -->
    @await RenderSectionAsync("Modals", required: false)

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Site JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
